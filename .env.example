# ============================================================
# 量化交易系统 - API 密钥与连接配置模板
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env  (cp .env.example .env)
#   2. 按需填入真实密钥
#   3. 绝不要将 .env 提交到 Git（已在 .gitignore 中忽略）
#
# 安全须知（职业合规）：
#   - 密钥即资金，泄露等同于交出账户控制权
#   - 生产环境建议使用密钥管理服务（如 Vault / KMS），而非明文 .env
#   - 实盘交易密钥应配置最小权限（只读+交易，禁止出金）
# ============================================================


# ============ 数据源 API（回测/研究阶段） ============

# --- Tushare (A股，https://tushare.pro) ---
# 免费额度有限，高级接口需积分。适合 A 股日线/财务/因子数据
TUSHARE_TOKEN=

# --- AKShare (A股，https://akshare.akfamily.xyz) ---
# 无需 token，开箱即用。适合快速验证与原型开发
# 以下为可选代理配置（内网/翻墙场景）
# AKSHARE_PROXY=http://127.0.0.1:7890

# --- yfinance (美股，https://finance.yahoo.com) ---
# 无需 token。适合美股/ETF 日线数据
# YFINANCE_PROXY=

# --- Alpha Vantage (全球，https://www.alphavantage.co) ---
# 免费版 5 次/分钟，适合外汇/加密/全球股票
ALPHA_VANTAGE_KEY=

# --- Polygon.io (美股/期权，https://polygon.io) ---
# 提供高质量分钟级数据与期权链，免费版限 5 次/分钟
POLYGON_API_KEY=

# --- Wind / Choice (专业终端，机构常用) ---
# 需安装本地客户端及 Python 接口（WindPy / EmQuantAPI）
# 接入方式见 docs/DATA_SOURCES.md
WIND_ENABLE=false
# CHOICE_USERNAME=
# CHOICE_PASSWORD=

# --- Binance / OKX (加密货币) ---
# 仅需公开行情时可不填；需交易权限时填入
BINANCE_API_KEY=
BINANCE_API_SECRET=
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_API_PASSPHRASE=


# ============ 实盘券商 API（实盘阶段，慎用） ============

# --- QMT (迅投，A股，需开通 QMT 权限) ---
# 国金/华泰/中泰等券商提供。Mini QMT 适合程序化交易
QMT_PATH=
QMT_ACCOUNT_ID=
QMT_TRADE_PASSWORD=

# --- 盈透证券 IBKR (全球，https://www.interactivebrokers.com) ---
# 需运行 TWS 或 IB Gateway 客户端
IB_HOST=127.0.0.1
IB_PORT=7497              # 7497=模拟 7496=实盘
IB_CLIENT_ID=1
IB_ACCOUNT=

# --- CCXT 统一加密货币接口 (https://docs.ccxt.com) ---
# 支持百家交易所，密钥格式见交易所 API 管理页
CCXT_EXCHANGE=binance     # binance / okx / bybit / ...
CCXT_API_KEY=
CCXT_API_SECRET=


# ============ 运行环境配置 ============

# 数据源优先级（逗号分隔，从左到右依次降级）
# cn: akshare,tushare,baostock  | us: yfinance,polygon,alpha_vantage
DATA_CN_FALLBACK=akshare,tushare
DATA_US_FALLBACK=yfinance,polygon

# 请求限流（秒），避免触发 API 频率限制
DATA_REQUEST_DELAY=0.5

# 无风险利率（用于夏普/Sortino 计算，默认中国 10 年国债收益率近似值）
RISK_FREE_RATE=0.025

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
